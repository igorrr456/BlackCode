@{
    ViewData["Title"] = "Black in Code | Criação e desenvolvimento de sites";
}

<div class="hero-glow text-white vw-100 position-relative start-50 translate-middle-x" data-bs-theme="dark">
    <section class="container text-center pt-5 pb-4">
        <span class="badge rounded-pill text-bg-dark border border-secondary fw-normal px-3 py-2 mb-4">
            Vamos começar? Seu próximo projeto começa aqui
        </span>

        <h1 class="display-4 fw-bold mb-3 text-white">
            Transformamos ideias em sites que <span class="text-primary">vendem</span>
        </h1>

        <p class="lead text-white-50 mb-5 mx-auto" style="max-width:720px">
            Na <strong class="text-white">Black in Code</strong>,
            criamos sites, lojas virtuais e sistemas web sob medida.
        </p>

        <a href="/Orcamento" class="btn btn-light btn-lg rounded-pill fw-semibold px-5 py-3 shadow-lg">
            Comece agora &rarr;
        </a>

        <p class="small text-white-50 mt-4 mb-0">
            Resposta rápida · Sem compromisso · Código limpo e entrega no prazo
        </p>
    </section>
    <section class="container text-center pb-5" style="padding-top: 20rem;">"
        <span class="text-primary text-uppercase fw-semibold small" style="letter-spacing:.15em ">Sobre a Black in Code</span>
        <h2 class="display-6 fw-bold mt-2 mb-3">Tecnologia com cara de projeto sob medida</h2>
        <p class="text-white-50 mx-auto mb-5" style="max-width:680px">
            Somos uma empresa de desenvolvimento web que cuida de todo o caminho: da primeira conversa ao site no ar,
            e depois dele. Cada projeto é construído do zero, com código limpo e foco no resultado do seu negócio.
        </p>

        <div class="row g-4 text-start">
            <div class="col-md-4">
                <div class="card-feature h-100 bg-black bg-opacity-50 border border-secondary rounded-4 p-4">
                    <div class="text-primary fw-bold fs-5 mb-3">01</div>
                    <h3 class="h5 fw-semibold">Design sob medida</h3>
                    <p class="text-white-50 mb-0">Nada de template genérico: o visual nasce da identidade da sua marca e conversa com o seu público.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-feature h-100 bg-black bg-opacity-50 border border-secondary rounded-4 p-4">
                    <div class="text-primary fw-bold fs-5 mb-3">02</div>
                    <h3 class="h5 fw-semibold">Código limpo e rápido</h3>
                    <p class="text-white-50 mb-0">Desenvolvimento moderno, seguro e responsivo, pensado para carregar rápido em qualquer dispositivo.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-feature h-100 bg-black bg-opacity-50 border border-secondary rounded-4 p-4">
                    <div class="text-primary fw-bold fs-5 mb-3">03</div>
                    <h3 class="h5 fw-semibold">Suporte de verdade</h3>
                    <p class="text-white-50 mb-0">Depois da entrega seguimos juntos, com manutenção, ajustes e evolução contínua do seu projeto.</p>
                </div>
            </div>
        </div>
    </section>
</div>
<section class="bg-black text-white vw-100 position-relative start-50 translate-middle-x" data-bs-theme="dark">
    <div class="row g-0">

        <div class="col-md-6">
            <div class="card-zoom position-relative overflow-hidden">
                <div class="ratio ratio-4x3">
                    <img src="~/Images/Manutenção.jpg" alt="Manutenção de sites" class="object-fit-cover">
                    </div>
                    <div class="card-overlay position-absolute bottom-0 start-0 w-100 p-4 p-lg-5">
                        <span class="badge rounded-pill text-bg-primary text-uppercase mb-3 px-3 py-2">Manutenção</span>
                        <h3 class="fw-bold">Seu site sempre rápido e seguro</h3>
                        <p class="mb-0 text-white-50">Atualizações, correções e monitoramento contínuo para o seu site nunca parar.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card-zoom position-relative overflow-hidden">
                    <div class="ratio ratio-4x3">
                        <img src="~/Images/Reestruturação.jpg" alt="Reestruturação de sites" class="object-fit-cover">
                        </div>
                        <div class="card-overlay position-absolute bottom-0 start-0 w-100 p-4 p-lg-5">
                            <span class="badge rounded-pill text-bg-light text-uppercase mb-3 px-3 py-2">Reestruturação</span>
                            <h3 class="fw-bold">Um site novo sobre a base que você já tem</h3>
                            <p class="mb-0 text-white-50">Modernizamos o design, a arquitetura e o código para ganhar desempenho e conversão.</p>
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex flex-wrap justify-content-center gap-3 py-5">
                <a href="#" class="btn btn-primary btn-lg text-uppercase fw-semibold px-4">Solicitar manutenção</a>
                <a href="#" class="btn btn-light btn-lg text-uppercase fw-semibold px-4">Solicitar reestruturação</a>
            </div>
        </section>
