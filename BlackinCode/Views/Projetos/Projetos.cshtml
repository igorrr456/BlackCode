@{
    ViewData["Title"] = "Projetos | Black in Code";

  
    var projetos = new[]
    {
        new { Numero = "01", Tag = "Sistema",  Titulo = "Sistema de Gestão",
              Descricao = "Painel administrativo com cadastros, relatórios e controle de acesso por perfil.",
              Tecnologias = new[] { "ASP.NET", "Bootstrap", "MySQL" },
              Imagem = "~/Images/SistemaGEstaoBiblioteca.png", Url = "#" },

        new { Numero = "02", Tag = "E-commerce", Titulo = "Loja Virtual",
              Descricao = "Loja responsiva com catálogo, carrinho de compras e acompanhamento de pedidos.",
              Tecnologias = new[] { "ASP.NET", "Bootstrap", "MySQL" },
              Imagem = "~/Images/LojaVitualCanecas.png", Url = "#" },

        new { Numero = "03", Tag = "Mobile",   Titulo = "Aplicativo Mobile",
              Descricao = "Aplicativo multiplataforma, rápido e fluido, para Android e iOS com um único código.",
              Tecnologias = new[] { "Flutter", "Dart" },
              Imagem = "~/Images/ListaAppMobile.png", Url = "#" },

        new { Numero = "04", Tag = "Web",      Titulo = "Portal de Agendamentos",
              Descricao = "Plataforma para clientes marcarem horários online, com painel de gestão para a empresa.",
              Tecnologias = new[] { "ASP.NET", "Bootstrap", "MySQL" },
              Imagem = "~/Images/ProjetoAspConcessionaria.jpg", Url = "#" },
    };
}

<section class="bg-black text-white vw-100 position-relative start-50 translate-middle-x overflow-hidden" data-bs-theme="dark">


    <div class="hero-glow">
        <div class="container text-center pt-5 mt-4 pb-5">
            <span class="badge rounded-pill text-bg-dark border border-secondary fw-normal px-3 py-2 mb-4">Portfólio</span>
            <h1 class="display-3 fw-bold">
                Nossos <span class="text-primary">Projetos</span>
            </h1>
            <p class="lead text-white-50 mx-auto mb-0" style="max-width:620px">
                Soluções reais, do sistema ao aplicativo. Clique na imagem para ver cada projeto.
            </p>
        </div>
    </div>


    <div class="container py-5">
        <div class="d-grid gap-5">
            @for (var i = 0; i < projetos.Length; i++)
            {
                var p = projetos[i];
                var invertido = i % 2 == 1;

                <article class="project-row reveal @(invertido ? "from-right" : "from-left")">
                    <div class="project-inner row g-0 align-items-stretch">
[]
                        <div class="col-lg-6 @(invertido ? "order-lg-2" : "")">
                            <a href="@p.Url" target="_blank" rel="noopener noreferrer"
                                   class="project-media card-zoom d-block position-relative overflow-hidden h-100"
                                   aria-label="Abrir projeto @p.Titulo">
                                <div class="ratio ratio-16x9 h-100">
                                    <img src="@Url.Content(p.Imagem)" alt="Projeto @p.Titulo" class="object-fit-cover">
                                </div>
                                <span class="project-shine" aria-hidden="true"></span>
                            </a>
                        </div>

                        @* Texto *@
                        <div class="col-lg-6 @(invertido ? "order-lg-1" : "")">
                            <div class="p-4 p-lg-5 d-flex flex-column justify-content-center h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="project-number">@p.Numero</span>
                                    <span class="project-tag badge rounded-pill text-bg-primary text-uppercase px-3 py-2">@p.Tag</span>
                                </div>

                                <h2 class="display-6 fw-bold mb-3">@p.Titulo</h2>
                                <p class="text-white-50 mb-4">@p.Descricao</p>

                                <div class="d-flex flex-wrap gap-2 mb-4">
                                    @foreach (var t in p.Tecnologias)
                                    {
                                        <span class="project-chip badge rounded-pill border border-secondary fw-normal px-3 py-2">@t</span>
                                    }
                                </div>

                                <div>
                                    <a href="@p.Url" target="_blank" rel="noopener noreferrer"
                                           class="project-link btn btn-light rounded-pill fw-semibold px-4">
                                        Ver projeto <span class="project-arrow">&rarr;</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>


    <div class="container text-center pb-5 pt-3">
        <h2 class="h3 fw-bold mb-3">Quer um projeto assim?</h2>
        <p class="text-white-50 mb-4">Conte sua ideia e receba uma estimativa em poucos minutos.</p>
        <a asp-controller="Orcamento" asp-action="Index" class="btn btn-primary btn-lg rounded-pill fw-semibold px-5">Comece agora &rarr;</a>
    </div>
</section>

@section Scripts {
    <script src="~/js/projetos.js" asp-append-version="true"></script>

}
@section Styles {
    <link rel="stylesheet" href="~/css/projetos.css" asp-append-version="true" />
}
