@{
    ViewData["Title"] = "Projetos | Black in Code";

 
    var projetos = new[]
    {
        new { Tag = "Sistema", Titulo = "Sistema de Gestão",  Descricao = "Painel administrativo com relatórios e controle de acesso.", Tecnologias = new[] { "ASP.NET", "MySQL", "Bootstrap" }, Imagem = "projeto1.jpg", Url = "#" },
        new { Tag = "Web",     Titulo = "Loja Virtual",       Descricao = "Loja responsiva com carrinho e pagamento online.",        Tecnologias = new[] { "HTML", "CSS", "JavaScript" }, Imagem = "projeto2.jpg", Url = "#" },
        new { Tag = "Mobile",  Titulo = "Aplicativo Mobile",  Descricao = "Aplicativo para acompanhar pedidos em tempo real.",       Tecnologias = new[] { "React Native", "API REST" },  Imagem = "projeto3.jpg", Url = "#" },
        new { Tag = "Site",    Titulo = "Site Institucional", Descricao = "Site rápido e otimizado para apresentar a empresa.",      Tecnologias = new[] { "ASP.NET MVC", "Bootstrap" },  Imagem = "ProjetoAspConcessionaria.jpg", Url = "" },
    };
}

<section class="bg-black text-white vw-100 position-relative start-50 translate-middle-x overflow-hidden" data-bs-theme="dark">

  
    <div class="hero-glow">
        <div class="container text-center pt-5 mt-4 pb-5">
            <span class="badge rounded-pill text-bg-dark border border-secondary fw-normal px-3 py-2 mb-4">Portfólio</span>
            <h1 class="display-3 fw-bold">
                Projetos que <span class="text-primary">saem do papel</span>
            </h1>
        </div>
    </div>

    @for (var fileira = 0; fileira < 2; fileira++)
    {
        <div class="marquee @(fileira == 1 ? "marquee-reverse" : "") pb-4">
            <div class="marquee-track">
                @for (var copia = 0; copia < 2; copia++)
                {
                    <div class="marquee-group" aria-hidden="@(copia == 1 ? "true" : "false")">
                        @foreach (var p in (fileira == 0 ? projetos : projetos.Reverse().ToArray()))
                        {
                            <article class="project-tile">
                                <a href="@p.Url" target="_blank" rel="noopener noreferrer"
                                       class="card-zoom position-relative d-block overflow-hidden ratio ratio-16x9"
                                       tabindex="@(copia == 1 ? "-1" : "0")" aria-label="Abrir projeto @p.Titulo">
                                    <img src="~/Images/Projetos/@p.Imagem" alt="Projeto @p.Titulo" class="object-fit-cover" loading="lazy">
                                    </a>

                                    <div class="p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge rounded-pill text-bg-primary text-uppercase">@p.Tag</span>
                                            <a href="@p.Url" target="_blank" rel="noopener noreferrer" tabindex="-1"
                                               class="small fw-semibold text-primary text-decoration-none">Ver projeto &nearr;</a>
                                        </div>
                                        <h2 class="h5 fw-bold mb-1">@p.Titulo</h2>
                                        <p class="small text-white-50 mb-3">@p.Descricao</p>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var t in p.Tecnologias)
                                            {
                                                <span class="badge rounded-pill border border-secondary fw-normal text-white-50">@t</span>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>
        }

    
        <div class="container text-center py-5">
            <h2 class="h3 fw-bold mb-3">Quer um projeto assim?</h2>
            <p class="text-white-50 mb-4">Conte sua ideia e receba uma estimativa em poucos minutos.</p>
            <a asp-controller="Orcamento" asp-action="Index" class="btn btn-light btn-lg rounded-pill fw-semibold px-5">Comece agora &rarr;</a>
        </div>
    </section>
