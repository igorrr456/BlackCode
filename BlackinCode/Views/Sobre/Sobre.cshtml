@{
    ViewData["Title"] = "Sobre";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/css/sobre.css" />

@* ===== HERO (tela cheia) ===== *@
<section class="about-hero text-white" id="aboutHero">
    <div class="about-hero-bg"></div>
    <div class="about-hero-overlay"></div>

    <div class="container position-relative about-hero-content">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
        <span class="about-tag">Sobre nós</span>
        <h1 class="fw-bold about-title">
            Tecnologia com cara de <span class="text-accent">projeto sob medida</span>
        </h1>
        <p class="about-lead">
            A Black in Code nasceu pra transformar ideias em sites, lojas virtuais e sistemas web
            que realmente trabalham pelo seu negócio. Do primeiro papo ao site no ar, e depois dele.
        </p>
        <div class="d-flex flex-wrap gap-3 mt-4">
            <a asp-controller="Contato" asp-action="Contato" class="btn btn-light rounded-pill px-4 py-2 fw-semibold">Fale com a gente</a>
            <a href="#historia" class="btn btn-outline-light rounded-pill px-4 py-2">Conheça nossa história</a>
        </div>
        </div>

        @* Mockup do lado direito (só aparece em telas grandes) *@
        <div class="col-lg-6 d-none d-lg-block">
            <div class="mock-wrap">
                <div class="mock-window">
                    <div class="mock-bar">
                        <span></span><span></span><span></span>
                        <em>seusite.com.br</em>
                    </div>
                    <div class="mock-body">
                        <div class="mock-nav">
                            <i></i>
                            <div><b></b><b></b><b></b></div>
                        </div>
                        <div class="mock-hero">
                            <div class="mock-line mock-line-lg"></div>
                            <div class="mock-line mock-line-lg short"></div>
                            <div class="mock-line"></div>
                            <div class="mock-btn"></div>
                        </div>
                        <div class="mock-cards">
                            <div></div><div></div><div></div>
                        </div>
                    </div>
                </div>

                <div class="mock-badge mock-badge-1"><i class="bi bi-lightning-charge-fill"></i> Carrega em 0,8s</div>
                <div class="mock-badge mock-badge-2"><i class="bi bi-phone"></i> 100% responsivo</div>
                <div class="mock-badge mock-badge-3"><i class="bi bi-shield-check"></i> Seguro</div>
            </div>
        </div>
      </div>
    </div>
</section>

@* ===== HISTÓRIA + NÚMEROS ===== *@
<section class="about-section" id="historia">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 reveal">
                <span class="about-tag">Nossa história</span>
                <h2 class="about-h2">Código limpo, <span class="text-accent">foco no resultado</span></h2>
                <p class="about-text">
                    Começamos com uma ideia simples: pequenos e médios negócios merecem uma presença digital
                    à altura, sem depender de template genérico nem de promessa vazia.
                </p>
                <p class="about-text">
                    Cada projeto é construído do zero, com design pensado na identidade da marca e
                    desenvolvimento moderno, seguro e responsivo. Depois da entrega, seguimos juntos
                    com manutenção, ajustes e evolução contínua.
                </p>
            </div>

            <div class="col-lg-6 reveal">
                <div class="row g-3">
                    @* Edite os números abaixo com os dados reais da empresa *@
                    <div class="col-6">
                        <div class="about-card stat-card">
                            <p class="stat-number">+20</p>
                            <p class="stat-label">Projetos entregues</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="about-card stat-card">
                            <p class="stat-number">100%</p>
                            <p class="stat-label">Feito sob medida</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="about-card stat-card">
                            <p class="stat-number">24h</p>
                            <p class="stat-label">Resposta rápida</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="about-card stat-card">
                            <p class="stat-number">+1 ano</p>
                            <p class="stat-label">De suporte incluso</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== VALORES ===== *@
<section class="about-section about-section-alt">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="about-tag">O que nos move</span>
            <h2 class="about-h2">Nossos <span class="text-accent">valores</span></h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4 reveal">
                <div class="about-card h-100">
                    <p class="about-num">01</p>
                    <h3 class="about-card-title">Design sob medida</h3>
                    <p class="about-card-text">Nada de template genérico: o visual nasce da identidade da sua marca e conversa com o seu público.</p>
                </div>
            </div>
            <div class="col-md-4 reveal">
                <div class="about-card h-100">
                    <p class="about-num">02</p>
                    <h3 class="about-card-title">Código limpo e rápido</h3>
                    <p class="about-card-text">Desenvolvimento moderno, seguro e responsivo, pensado para carregar rápido em qualquer dispositivo.</p>
                </div>
            </div>
            <div class="col-md-4 reveal">
                <div class="about-card h-100">
                    <p class="about-num">03</p>
                    <h3 class="about-card-title">Suporte de verdade</h3>
                    <p class="about-card-text">Depois da entrega seguimos juntos, com manutenção, ajustes e evolução contínua do seu projeto.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== PROCESSO ===== *@
<section class="about-section">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="about-tag">Como trabalhamos</span>
            <h2 class="about-h2">Do primeiro papo ao <span class="text-accent">site no ar</span></h2>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3 reveal">
                <div class="about-step">
                    <span class="about-step-icon"><i class="bi bi-chat-dots"></i></span>
                    <h3 class="about-card-title">Conversa</h3>
                    <p class="about-card-text">Entendemos seu negócio, seus objetivos e o que o projeto precisa entregar.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 reveal">
                <div class="about-step">
                    <span class="about-step-icon"><i class="bi bi-palette"></i></span>
                    <h3 class="about-card-title">Design</h3>
                    <p class="about-card-text">Criamos o visual alinhado à sua marca e validamos com você antes de codar.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 reveal">
                <div class="about-step">
                    <span class="about-step-icon"><i class="bi bi-code-slash"></i></span>
                    <h3 class="about-card-title">Desenvolvimento</h3>
                    <p class="about-card-text">Construímos do zero, com código limpo, seguro e pronto para crescer.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 reveal">
                <div class="about-step">
                    <span class="about-step-icon"><i class="bi bi-rocket-takeoff"></i></span>
                    <h3 class="about-card-title">Entrega e suporte</h3>
                    <p class="about-card-text">Publicamos no ar e continuamos ao seu lado com manutenção e evolução.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== TECNOLOGIAS ===== *@
<section class="about-section about-section-alt">
    <div class="container text-center reveal">
        <span class="about-tag">Tecnologias</span>
        <h2 class="about-h2 mb-4">Ferramentas que <span class="text-accent">usamos</span></h2>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <span class="about-chip">C#</span>
            <span class="about-chip">ASP.NET Core</span>
            <span class="about-chip">JavaScript</span>
            <span class="about-chip">React</span>
            <span class="about-chip">SQL Server</span>
            <span class="about-chip">MySQL</span>
            <span class="about-chip">Git</span>
            <span class="about-chip">JWT</span>
        </div>
    </div>
</section>

<script src="~/js/sobre.js" defer></script>
