@model BlackinCode.Models.Usuario
@{
    ViewData["Title"] = "Criar conta | Black in Code";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Sora:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-page hero-glow text-white" data-bs-theme="dark">
    <div class="text-center w-100" style="max-width:420px">

        <div class="login-box card-feature bg-black bg-opacity-50 border border-secondary rounded-4 p-4 p-md-5 mx-auto">
            <h1 class="h2 fw-bold mb-2">Crie sua conta</h1>
            <p class="text-white-50 mb-4">Preencha os dados abaixo para começar.</p>

            <form asp-action="CriarConta" method="post" class="text-start" novalidate>
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">Nome</label>
                    <input asp-for="Nome" type="text" class="form-control" placeholder="Seu nome" autocomplete="name" required />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Seu e-mail" autocomplete="email" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Senha" class="form-label">Senha</label>
                    <input asp-for="Senha" type="password" class="form-control" placeholder="Crie uma senha" autocomplete="new-password" required />
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-entrar w-100 rounded-pill fw-semibold py-2">Criar conta</button>
            </form>

            <p class="small text-white-50 mt-4 mb-0">
                Já tem uma conta?
                <a class="login-link" asp-action="Logar">Entrar</a>
            </p>
        </div>

        <p class="small text-white-50 mt-4 mb-0">
            Black in Code · Sites, lojas virtuais e sistemas web sob medida
        </p>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
