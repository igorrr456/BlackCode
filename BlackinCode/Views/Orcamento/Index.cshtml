@model IReadOnlyList<BlackinCode.Models.EtapaOrcamento>

@{
    ViewData["Title"] = "Orçamento | Black in Code";

    var whatsapp = "5511999999999";
}

@section Styles {
    <link rel="stylesheet" href="~/css/orcamento.css" asp-append-version="true" />
}

<div class="orc" id="orc" data-bs-theme="dark"
     data-whatsapp="@whatsapp"
     data-calcular-url="@Url.Action("Calcular", "Orcamento")">

    <div class="orc-head">
        <div class="orc-head-left">
            <a class="orc-logo" href="@Url.Action("Index", "Home")" data-sair aria-label="Voltar para a Home">
                <img src="~/Images/Logobc.png" alt="Black in Code" />
            </a>
            <button class="orc-back" id="orcBack" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                <span>Anterior</span>
            </button>
        </div>
        <div class="orc-total js-total" aria-label="Total parcial">R$ 0,00</div>
        <div class="orc-head-right">
            <span class="orc-count" id="orcCount"></span>
            <a class="orc-close" href="@Url.Action("Index", "Home")" data-sair aria-label="Sair do orçamento">
                <span>Sair</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </a>
        </div>
    </div>
    <div class="orc-track"><i id="orcProg"></i></div>

    <div class="orc-body" id="orcBody"></div>
</div>

<script id="orcamento-dados" type="application/json">@Json.Serialize(Model)</script>

@section Scripts {
    <script src="~/js/orcamento.js" asp-append-version="true"></script>
}
