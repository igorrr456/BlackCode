@{
    ViewData["Title"] = "Serviços | Black in Code";
}

<section class="bg-black text-white vw-100 position-relative start-50 translate-middle-x" data-bs-theme="dark">
    <div class="container pt-5 pb-5">

        <div class="pt-5 mt-4 mb-5">
            <span class="text-primary text-uppercase fw-semibold small" style="letter-spacing:.15em">O que oferecemos para você</span>
            <h1 class="display-4 fw-bold mt-2 mb-3">Serviços<span class="text-primary">.</span></h1>
            <p class="lead text-white-50 mb-0" style="max-width:640px">
                Do aplicativo à infraestrutura: cuidamos de todas as etapas para a sua ideia sair do papel e funcionar de verdade.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-4">
                <article class="card-feature h-100 d-flex flex-column bg-black bg-opacity-50 border border-secondary rounded-4 p-4 p-xl-5">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-inline-flex p-3 mb-4 align-self-start">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="7" y="2" width="10" height="20" rx="2.5" />
                            <line x1="11" y1="18" x2="13" y2="18" />
                        </svg>
                    </div>
                    <h2 class="h4 fw-bold">Desenvolvimento de Apps</h2>
                    <p class="text-white-50">Aplicativos para Android e iOS, com a identidade da sua marca e uma experiência fluida no celular.</p>
                    <ul class="list-unstyled d-grid gap-2 small mb-4">
                        <li><span class="text-primary me-2">&#10003;</span>Android e iOS</li>
                        <li><span class="text-primary me-2">&#10003;</span>Design de telas e experiência de uso</li>
                        <li><span class="text-primary me-2">&#10003;</span>Publicação nas lojas de aplicativos</li>
                    </ul>
                    <a asp-controller="Orcamento" asp-action="Index" class="mt-auto fw-semibold text-white text-decoration-none">
                        Solicitar orçamento 
                    </a>
                </article>
            </div>


            <div class="col-lg-4">
                <article class="card-feature h-100 d-flex flex-column bg-black bg-opacity-50 border border-secondary rounded-4 p-4 p-xl-5">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-inline-flex p-3 mb-4 align-self-start">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 18a4 4 0 0 1-.5-7.97A6 6 0 0 1 18 9.5 4.5 4.5 0 0 1 17.5 18z" />
                        </svg>
                    </div>
                    <h2 class="h4 fw-bold">Hospedagem em Nuvem</h2>
                    <p class="text-white-50">Sua aplicação no ar com segurança, estabilidade e espaço para crescer junto com o seu negócio.</p>
                    <ul class="list-unstyled d-grid gap-2 small mb-4">
                        <li><span class="text-primary me-2">&#10003;</span>Migração de dados e sistemas</li>
                        <li><span class="text-primary me-2">&#10003;</span>Armazenamento e backups</li>
                        <li><span class="text-primary me-2">&#10003;</span>Segurança e monitoramento</li>
                    </ul>
                    <a asp-controller="Orcamento" asp-action="Index" class="mt-auto fw-semibold text-white text-decoration-none">
                        Solicitar orçamento 
                    </a>
                </article>
            </div>

            <div class="col-lg-4">
                <article class="card-feature h-100 d-flex flex-column bg-black bg-opacity-50 border border-secondary rounded-4 p-4 p-xl-5">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-inline-flex p-3 mb-4 align-self-start">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="8 7 3 12 8 17" />
                            <polyline points="16 7 21 12 16 17" />
                            <line x1="14" y1="5" x2="10" y2="19" />
                        </svg>
                    </div>
                    <h2 class="h4 fw-bold">Desenvolvimento de Sistemas</h2>
                    <p class="text-white-50">Sistemas web sob medida para organizar, automatizar e dar visão clara da operação da sua empresa.</p>
                    <ul class="list-unstyled d-grid gap-2 small mb-4">
                        <li><span class="text-primary me-2">&#10003;</span>Painéis administrativos e relatórios</li>
                        <li><span class="text-primary me-2">&#10003;</span>Integração com outros sistemas</li>
                        <li><span class="text-primary me-2">&#10003;</span>Desenvolvimento em .NET</li>
                    </ul>
                    <a asp-controller="Orcamento" asp-action="Index" class="mt-auto fw-semibold text-white text-decoration-none">
                        Solicitar orçamento 
                    </a>
                </article>
            </div>
        </div>

  
        <div class="text-center mt-5 pt-4">
            <h2 class="h3 fw-bold mb-3">Tem um projeto em mente?</h2>
            
            <a asp-controller="Orcamento" asp-action="Index" class="btn btn-light btn-lg rounded-pill fw-semibold px-5">Comece agora</a>
        </div>
    </div>
</section>